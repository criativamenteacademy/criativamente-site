{
  "name": "criativamente-site",
  "main": "./worker/controle-publicacao.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/posicionamento-estrategico*",
      "/patrimonio-protegido*",
      "/negocio-e-estrategia*",
      "/inteligencia-artificial-e-produtividade*",
      "/curso-2-inteligencia-artificial-e-produtividade*"
    ]
  }
}